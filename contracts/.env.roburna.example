# Copy to contracts/.env.roburna for the Roburna deployment.
FAUCET_RPC_URL=https://preseed-testnet-1.roburna.com
FAUCET_EXPECTED_CHAIN_ID=159
FAUCET_DEPLOYER=0x7c2Eb5047858AD800414Dc8Ac60417A5d73be409
FAUCET_ADMIN=0xbDd4628028F85bb7C4aECd9d1F426aE9525aF8F4
FAUCET_DISTRIBUTOR=0x546501e0c1d35822CcA63ef2A4787Ff1c2367079
# 10 RBAT per payout; 1000 RBAT per UTC day (up to 100 full payouts).
FAUCET_RECIPIENT_BALANCE_LIMIT_WEI=10000000000000000000
FAUCET_MAX_PAYOUT_WEI=10000000000000000000
FAUCET_SPENDING_LIMIT_WEI=1000000000000000000000
FAUCET_PERIOD_SECONDS=86400
FAUCET_SIGNER_MODE=keystore
FAUCET_DEPLOYER_ACCOUNT=roburna-deployer
FAUCET_LEGACY_GAS=true
