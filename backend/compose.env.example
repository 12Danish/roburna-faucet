# Copy to compose.env. Keep this file private and stable across restarts.
# Use a URL-safe PostgreSQL password (letters and digits), or URL-encode it in
# BACKEND_DATABASE_URL. These two passwords must match.
POSTGRES_DB=roburna_faucet
POSTGRES_USER=faucet_app
POSTGRES_PASSWORD=replace_with_long_random_url_safe_password
BACKEND_DATABASE_URL=postgresql://faucet_app:replace_with_long_random_url_safe_password@db:5432/roburna_faucet
BACKEND_RPC_URLS={"ROBURNA_TESTNET":"https://preseed-testnet-1.roburna.com"}
BACKEND_SIWE_DOMAIN=localhost:3000
BACKEND_SIWE_URI=http://localhost:3000
BACKEND_RATE_LIMIT_HASH_SECRET=replace_with_random_64_hex_characters
BACKEND_TRUSTED_PROXY_CIDRS=[]
# Password for the encrypted distributor keystore; only the worker receives it.
BACKEND_DISTRIBUTOR_KEYSTORE_PASSWORD=replace_with_keystore_password
BACKEND_PORT=8000
# Set these to the owner of secrets/distributor.json (id -u; id -g).
BACKEND_UID=1000
BACKEND_GID=1000
