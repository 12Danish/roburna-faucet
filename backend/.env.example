# Copy to .env for local development. Do not commit .env.
BACKEND_DATABASE_URL=postgresql://faucet:faucet@127.0.0.1:5432/faucet
BACKEND_CHAINS_CONFIG=config/chains.json

# RPC endpoints stay in environment configuration, keyed by each chain's rpc_url_key.
BACKEND_RPC_URLS='{"ANVIL":"http://127.0.0.1:8545"}'
