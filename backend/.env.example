# Copy to .env for local development. Do not commit .env.
BACKEND_DATABASE_URL=postgresql://faucet_app:YOUR_PASSWORD@127.0.0.1:5432/roburna_faucet
BACKEND_CHAINS_CONFIG=config/chains.json

# RPC endpoints stay in environment configuration, keyed by each chain's rpc_url_key.
BACKEND_RPC_URLS='{"ANVIL":"http://127.0.0.1:8545"}'

# SIWE challenge origin shown in the wallet signing prompt. Set these to the
# frontend's public origin before enabling a public faucet.
BACKEND_SIWE_DOMAIN=localhost:3000
BACKEND_SIWE_URI=http://localhost:3000
BACKEND_CHALLENGE_TTL_SECONDS=300
